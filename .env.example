# --- AI ---
# Required by BOTH the P2 engine (judge + classifier + embeddings) and the P3
# demo agents / judge wrapper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GPTZERO_API_KEY=

# --- Eval harness: LLM judges for the model comparison (P3) ---
# Model ids are env-overridable on purpose; provider names move fast.
# NOTE: the P3 judge wrapper reads GEMINI_API_KEY. P2's .env.example calls the
# same key GOOGLE_API_KEY. Set both to the same value until we agree on one.
GEMINI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# Which evaluate() the harness and agents use: "stub" (default) or "engine".
# "engine" now means P2's Python service over HTTP -- start it first:
#   cd packages/engine && ./setup.sh && ./venv/bin/uvicorn server:app --port 8000
AGENTGATE_ENGINE=stub
AGENTGATE_ENGINE_URL=http://localhost:8000
AGENTGATE_ENGINE_TIMEOUT_MS=30000

# --- Engine tuning (P2) ---
AGENTGATE_JUDGE_MODEL=gpt-4o
AGENTGATE_CLASSIFIER_MODEL=gpt-4o-mini
AGENTGATE_EMBED_MODEL=text-embedding-3-small
# Cumulative spend trigger. See the note in SHARED_CONTEXT.md -- the engine
# books spend on every allowed financial action, so a PO plus its matching
# payment counts twice against this limit.
AGENTGATE_SESSION_SPEND_LIMIT=5000

# --- Observability ---
SENTRY_DSN=
# AGENTGATE_DEBUG_SENTRY=1   # turns on the Sentry SDK's own logging
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# NOTE: drift -- P3 reads LANGFUSE_BASE_URL, P2's engine reads LANGFUSE_BASEURL.
# Set both until we pick one.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_BASEURL=https://cloud.langfuse.com

# --- Cloudflare (P2 engine storage) ---
# With these set, the engine uses Vectorize for RAG and D1 for session state
# instead of in-memory stores. Token needs Vectorize:Edit and D1:Edit.
# Run: ./venv/bin/python cloudflare_setup.py
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX=agentgate-policies
D1_DATABASE_ID=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# --- Eval run history (P3; MongoDB Atlas free tier) ---
# P3 eval runs only. Agent action logs belong in P1's D1 store, not here.
MONGODB_URI=
MONGODB_DB=agentgate

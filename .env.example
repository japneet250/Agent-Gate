# --- Demo agents (Person 3) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Eval harness: LLM judges for the model comparison ---
# Model ids are env-overridable on purpose; provider names move fast.
GEMINI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# Which evaluate() the harness and agents use: "stub" (default) or "engine" (P2).
AGENTGATE_ENGINE=stub

# --- Observability (Person 3) ---
SENTRY_DSN=
# AGENTGATE_DEBUG_SENTRY=1   # turns on the Sentry SDK's own logging
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Eval run history (Person 3; MongoDB Atlas free tier) ---
# P3 eval runs only. Agent action logs belong in P1's D1 store, not here.
MONGODB_URI=
MONGODB_DB=agentgate

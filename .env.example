# --- AI ---
# Required by BOTH the P2 engine (judge + classifier + embeddings) and the P3
# demo agents / judge wrapper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GPTZERO_API_KEY=

# --- Eval harness: LLM judges for the model comparison (P3) ---
# Model ids are env-overridable on purpose; provider names move fast.
# NOTE: the P3 judge wrapper reads GEMINI_API_KEY. P2's .env.example calls the
# same key GOOGLE_API_KEY. Set both to the same value until we agree on one.
GEMINI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-4o-mini
GEMINI_JUDGE_MODEL=gemini-3.6-flash

# Which evaluate() the harness and agents use: "stub" (default) or "engine".
# "engine" now means P2's Python service over HTTP -- start it first:
#   cd packages/engine && ./setup.sh && ./venv/bin/uvicorn server:app --port 8000
AGENTGATE_ENGINE=stub
AGENTGATE_ENGINE_URL=http://localhost:8000
AGENTGATE_ENGINE_TIMEOUT_MS=30000

# --- Engine tuning (P2) ---
AGENTGATE_JUDGE_MODEL=gpt-4o
AGENTGATE_CLASSIFIER_MODEL=gpt-4o-mini
AGENTGATE_EMBED_MODEL=text-embedding-3-small
# Cumulative spend trigger. See the note in SHARED_CONTEXT.md -- the engine
# books spend on every allowed financial action, so a PO plus its matching
# payment counts twice against this limit.

# --- Observability ---
SENTRY_DSN=
# AGENTGATE_DEBUG_SENTRY=1   # turns on the Sentry SDK's own logging
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LangFuse Cloud is regional and the keys only work against their own region.
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
# Wrong region gives a 401 reading "Confirm that you've configured the correct
# host", which looks like a bad key and is not. THIS PROJECT IS ON US.
# NOTE: name drift -- P3 reads LANGFUSE_BASE_URL, P2's engine reads
# LANGFUSE_BASEURL. Set both to the same value until we pick one.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_BASEURL=https://us.cloud.langfuse.com

# --- Cloudflare (P2 engine storage) ---
# With these set, the engine uses Vectorize for RAG and D1 for session state
# instead of in-memory stores. Token needs Vectorize:Edit and D1:Edit.
# Run: ./venv/bin/python cloudflare_setup.py
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX=agentgate-policies
D1_DATABASE_ID=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# Shared secret for the engine's HTTP API. Leave empty for localhost-only use;
# ALWAYS set it before tunnelling or deploying, or anyone can spend your OpenAI
# credit. P3's eval harness sends it as `Authorization: Bearer <key>`.
AGENTGATE_API_KEY=

# --- Zip (procurement sponsor) ---
# From Zip's HTN setup doc. Get a key at {your-domain}/manage/api-key (ping #spons-zip-2026 for access).
# These names are read by ziphq-mcp AND by the engine's REST grounding, so one set is enough.
# Older names still work and win if set: ZIP_API_TOKEN (key), ZIP_API_BASE (host).
# Staging only. api.ziphq.com is production and answers the same welcome banner.
# The engine sends the key as `Zip-Api-Key`, NOT `Authorization: Bearer`.
ZIP_API_URL=https://staging-api.zip.com
ZIP_API_KEY=
# readwrite exposes all 131 tools (66 write/delete). Unset, Zip shows only ~60 read tools.
ZIP_MCP_MODE=readwrite
# Optional: override how ziphq-mcp is launched. Default is `uv run --with ziphq-mcp ziphq-mcp`.
# ZIP_MCP_COMMAND=
# Diagnose an empty result: cd packages/engine && ./venv/bin/python zip_probe.py

# --- Eval run history (P3; MongoDB Atlas free tier) ---
# P3 eval runs only. Agent action logs belong in P1's D1 store, not here.
MONGODB_URI=
MONGODB_DB=agentgate

# ---- merged from Person 1's branch ----
# Copy to .env and fill in. Never commit .env.
# The D1 database everyone shares (printed by `wrangler d1 create agentgate`)
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional label shown in Sentry (default: local for Node, production on the Worker)
# SENTRY_ENVIRONMENT=
# Person 2's AI judge. URL is the full evaluate endpoint. On the Worker both are set as secrets (wrangler secret put).
AGENTGATE_ENGINE_URL=
AGENTGATE_ENGINE_KEY=
# Optional: how long to wait for the judge (default 8000) and what to answer if it can't reply (allow|escalate|block, default escalate)
# AGENTGATE_JUDGE_TIMEOUT_MS=8000
# AGENTGATE_JUDGE_ON_ERROR=escalate

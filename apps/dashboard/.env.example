# mock  = deterministic replay from fixtures derived from the real eval suite.
#         The demo works with no backend, no keys and no network.
# live  = talk to P1's gateway and P2's engine.
NEXT_PUBLIC_DATA_MODE=mock

# LiveProvider targets. See lib/data/live-provider.ts for the exact contract.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000

# Server-side only — NO NEXT_PUBLIC_ prefix. Used by app/api/policies to reach
# the engine. A NEXT_PUBLIC_ variable is inlined into the browser bundle, and
# this key also authorises /evaluate, which spends money.
AGENTGATE_API_KEY=
ENGINE_URL=http://localhost:8000
